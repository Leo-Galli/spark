{
  "name": "tickdown",
  "version": "0.1.0",
  "description": "CLI that turns Markdown checklists into tracked tasks with stable IDs",
  "type": "module",
  "bin": {
    "tickdown": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.js",
    "tickdown": "npm run build && node dist/cli.js",
    "format": "node -e \"console.log('format: use your local formatter')\"",
    "format:check": "node -e \"process.exit(0)\"",
    "lint": "node -e \"process.exit(0)\"",
    "audit": "npm audit --omit=dev",
    "secrets:check": "node scripts/secrets-check.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.16.11",
    "typescript": "^5.6.3"
  }
}
